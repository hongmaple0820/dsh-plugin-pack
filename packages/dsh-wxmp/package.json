{
  "name": "@local/dsh-wxmp",
  "version": "0.1.0",
  "private": true,
  "description": "微信公众号文章接入：扫码登录 + 搜号/文章列表/正文抓取 + 订阅本地库 + Agent 工具 + 可视化页面",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/wechat": "./lib/wechat.js",
    "./lib/auth": "./lib/auth.js",
    "./lib/store": "./lib/store.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
