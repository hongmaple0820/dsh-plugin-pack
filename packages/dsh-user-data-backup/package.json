{
  "name": "@local/dsh-user-data-backup",
  "version": "1.0.0",
  "private": true,
  "description": "独立数据管理：备份预览、可靠恢复与远程备份",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js"
  },
  "overrides": {
    "webdav": {
      "minimatch": "^11.0.9"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.1",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "esbuild": "0.28.2",
    "fflate": "^0.8.2",
    "playwright": "^1.63.0",
    "webdav": "^5.8.0",
    "webdav-server": "^2.6.2",
    "yaml": "^2.8.1",
    "yauzl": "^3.2.0"
  },
  "files": [
    "index.js",
    "src",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
