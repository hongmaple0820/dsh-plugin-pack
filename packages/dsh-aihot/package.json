{
  "name": "@local/dsh-aihot",
  "version": "2.0.0",
  "private": true,
  "description": "AIHOT 中文 AI 资讯接入：8 个 Host 工具 + AI 资讯页面",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/aihot": "./lib/aihot.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
